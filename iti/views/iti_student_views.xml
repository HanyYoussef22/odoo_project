<odoo>
    <data>
        <!-- Define the tree view for iti.student -->
        <record id="view_patient_tree" model="ir.ui.view">
            <field name="name">iti.student.tree</field>
            <field name="model">iti.student</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="age"/>
                    <field name="birth_date"/>
                    <field name="salary"/>
                    <field name="address"/>

                </tree>
            </field>
        </record>
        <record id="view_student_form" model="ir.ui.view">
            <field name="name">iti.student.form</field>
            <field name="model">iti.student</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group string="Personal Information">
                                <field name="name"/>
                                <field name="age"/>
                                <field name="gender"/>
<!--                                       attrs="{'invisible':[('gender','=','f')]}"-->

                                <field name="birth_date"/>
                                <field name="track_id" domain="[('isOpen','=','True')]"/>
                                 <field name="track_capacity"/>

                            </group>
                            <group string="Other Information">
                                <field name="skills_id" widget="many2many_tags"/>
                                <field name="image" widget="image"/>
                                <field name="salary"/>

                            </group>
                        </group>
                        <notebook>
                            <page string="cv">
                                <group>
                                    <field name="cv"/>
                                </group>
                            </page>
                            <page string="address">
                                <field name="address"/>
                            </page>
                            <page string="courses">
                                <field name="student_grade_id">
                                    <tree>
                                        <field name="course_id"/>
                                        <field name="degree"/>
                                        <field name="student_id"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="student_action" model="ir.actions.act_window">
            <field name="name">student_name</field>
            <field name="res_model">iti.student</field>
        </record>
  
        <!-- Menu item without parent & action -->
        <menuitem id="student_root" name="ITI Student"/>
        <!-- Menu item with parent & action -->
        <menuitem id="student_menu" name="student" parent="student_root" action="student_action"/>
    </data>
</odoo>

