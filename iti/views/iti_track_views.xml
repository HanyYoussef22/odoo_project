<odoo>
    <data>

        <record id="view_track_tree" model="ir.ui.view">
            <field name="name">iti.track.tree</field>
            <field name="model">iti.track</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="capacity"/>
                    <field name="isOpen"/>
                </tree>
            </field>
        </record>

        <record id="view_track_form" model="ir.ui.view">
            <field name="name">iti.track.form</field>
            <field name="model">iti.track</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="isOpen"/>
                        </group>

                        <group>
                            <field name="capacity"/>
                            <field name="student_id"/>
                        </group>


                    </sheet>
                </form>
            </field>

        </record>

        <record id="track_action" model="ir.actions.act_window">
            <field name="name">Tracks</field>
            <field name="res_model">iti.track</field>
        </record>


        <menuitem id="track_menu" name="Track" parent="student_root" action="track_action"/>
    </data>
</odoo>